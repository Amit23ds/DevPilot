.env
.env.*
.env*
application.properties
application.yml
application.yaml
!application-example.properties
*.pem
*.key
*.p12
*.jks
credentials.json
client_secret*.json
service-account*.json

### Java / Maven / Spring Boot ###
target/
!**/src/main/**/target/
!**/src/test/**/target/
build/
!**/src/main/**/build/
!**/src/test/**/build/
*.class
**/.mvn/wrapper/maven-wrapper.jar
/backend/HELP.md

